  "amends_commit": "488c7e9600fd02820c5b97d49c89f1a95088e51d",
  "original_still_scored": true,
  "amendment_rationale": {
    "defect_1": "M5 statistics described full datasets; the frozen M7 policy subsamples train to <=4000 rows and caps d at 500. Real statistics are recomputed on the training split the learner actually receives, matching how M3 computed them.",
    "defect_2": "g was fit on synthetic n in [200, 993]; real n reaches 566602 (571x). Unclipped ridge extrapolation produced predictions up to 242.6 against a training target range of [-0.35, 0.83], and correlated +0.90 with n alone. Statistics are now clipped to the synthetic support so g interpolates.",
    "unchanged": [
      "DGP library",
      "statistic definitions",
      "g coefficients",
      "tau"
    ],
    "outcome_information_used": "none; no TabPFN run has touched a real dataset"
  },
  "canonical_split_seed": 0,
  "decision_threshold_tau": 0.04483829986575805,
  "threshold_rule": {
    "statistic": "percentile",
    "percentile": 75,
    "reference_family": "scm_prior_control",
    "justification": "tau is the 75th percentile of TabPFN's Bayes regret on scm_prior_control, the in-prior anchor. Reading the threshold off the anchor rather than off the pooled sweep makes \"out of prior\" mean \"worse than TabPFN's own typical in-prior behaviour\", which is the quantity the paper claims to predict, and keeps tau independent of how the rest of the parameter space was sampled.\n"
  },
