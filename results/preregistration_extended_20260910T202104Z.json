    200,
    3733
  ],
  "decision_threshold_tau": 0.04247127286144796,
  "threshold_rule": {
    "statistic": "percentile",
    "percentile": 75,
    "reference_family": "scm_prior_control",
    "justification": "tau is the 75th percentile of TabPFN's Bayes regret on scm_prior_control, the in-prior anchor. Reading the threshold off the anchor rather than off the pooled sweep makes \"out of prior\" mean \"worse than TabPFN's own typical in-prior behaviour\", which is the quantity the paper claims to predict, and keeps tau independent of how the rest of the parameter space was sampled.\n"
  },
